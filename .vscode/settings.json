{
  "java.compile.nullAnalysis.mode": "automatic",
  "dart.getFlutterSdkCommand": {
    "executable": "mise",
    "args": ["where", "flutter"]
  },
  "dart.getDartSdkCommand": {
    "executable": "bash",
    "args": [
      "-c",
      "sdk=$(mise where flutter) || exit 1; echo \"$sdk/bin/cache/dart-sdk\""
    ]
  }
}
